rules_version = '2';
// 旅行は「members」に入っているGoogleアカウントだけが読み書きできます。
// 共有相手はアプリの ⚙️ →「共有するGoogleアカウント」で追加します（ここを書き換える必要はありません）。
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember(data) { return signedIn() && me() in data.members; }

    match /trips/{tripId} {
      allow read, delete: if isMember(resource.data);
      allow create: if isMember(request.resource.data);
      // 自分を共有メンバーから外す変更はできない（締め出し防止）
      allow update: if isMember(resource.data) && isMember(request.resource.data);

      match /items/{itemId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }
  }
}
