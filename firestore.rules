rules_version = '2';
// 旅行は「members」に入っているGoogleアカウントだけが読み書きできます。
// 新しく旅行を作れるのは ALLOWED に入っている人だけです（一緒に旅する人が増えたらここに追加）。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function allowed() { return signedIn() && me() in ['YOUR_EMAIL@gmail.com', 'PARTNER_EMAIL@gmail.com']; }

    match /trips/{tripId} {
      allow read, update, delete: if allowed() && me() in resource.data.members;
      allow create: if allowed() && me() in request.resource.data.members;

      match /items/{itemId} {
        allow read, write: if allowed()
          && me() in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }
    }
  }
}
